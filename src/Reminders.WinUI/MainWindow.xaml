<Window x:Class="Reminders.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Reminders.Windows"
 xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
 Title="Reminders for Windows">
 <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
  <Grid.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AppleTheme.xaml"/></ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="AppleReminderTemplate">
     <Grid Padding="10,10,12,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding Completed, Mode=TwoWay}" Click="Complete_Click" Style="{StaticResource AppleCheckBoxStyle}" VerticalAlignment="Top" AutomationProperties.Name="Mark reminder complete"/>
      <StackPanel Grid.Column="1" Spacing="5">
       <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource AppleTextBrush}" TextTrimming="CharacterEllipsis"/>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ApplePriority, Mode=OneWay}" Foreground="{Binding AppleDueBrush, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
        <TextBlock Grid.Column="1" Text="{Binding DueText, Mode=OneWay}" Foreground="{Binding AppleDueBrush, Mode=OneWay}" FontSize="13"/>
        <TextBlock Grid.Column="2" Text="{Binding AppleTags, Mode=OneWay}" Foreground="{ThemeResource AppleBlueBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Text="{Binding ApplePending, Mode=OneWay}" Foreground="{ThemeResource AppleBlueBrush}" FontSize="13" AutomationProperties.Name="{Binding AppleSyncDescription}"/>
       </Grid>
       <Border Height="1" Background="{ThemeResource AppleDividerBrush}" Margin="0,8,0,0"/>
      </StackPanel>
     </Grid>
    </DataTemplate>

   </ResourceDictionary>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="AppleSidebarColumn" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAccelerator_Invoked"/>
   <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked"/>
  </Grid.KeyboardAccelerators>
  <Grid x:Name="AppleSidebar" Visibility="Collapsed" Background="{ThemeResource AppleSidebarBrush}" BorderBrush="{ThemeResource AppleDividerBrush}" BorderThickness="0,0,1,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="18,14,12,10">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Reminders" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AppleTextBrush}" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSync_Click" AutomationProperties.Name="Sync now" ToolTipService.ToolTip="Sync now"><FontIcon Glyph="&#xE895;" FontSize="16"/></Button>
    <Button Grid.Column="2" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSettings_Click" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings (Ctrl+,)"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
   </Grid>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <ListView x:Name="AppleSmartLists" SelectionChanged="AppleNavigation_SelectionChanged" ItemContainerStyle="{StaticResource AppleRowStyle}" Padding="10,0"/>
     <Border Height="1" Background="{ThemeResource AppleDividerBrush}" Margin="0,12,0,10"/>
     <TextBlock Text="LISTS" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="18,0,0,8"/>
     <ListView x:Name="AppleLists" SelectionChanged="AppleNavigation_SelectionChanged" ItemContainerStyle="{StaticResource AppleRowStyle}" Padding="10,0"/>
     <Border Height="1" Background="{ThemeResource AppleDividerBrush}" Margin="0,12,0,10"/>
     <TextBlock Text="TAGS" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="18,0,0,8"/>
     <ItemsControl x:Name="AppleTags" Margin="18,0,14,14"/>
     <TextBlock Text="Tags are read-only." TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" Margin="18,0,18,16"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2" BorderBrush="{ThemeResource AppleDividerBrush}" BorderThickness="0,1,0,0" Padding="18,12" Spacing="4">
    <Button x:Name="AppleConflicts" Content="Sync conflicts" Visibility="Collapsed" Click="AppleConflicts_Click"/>
    <TextBlock x:Name="AppleSyncStatus" Text="Ready to sync" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  <NavigationView Grid.Column="1" x:Name="Navigation" PaneTitle="Reminders for Windows" IsBackButtonVisible="Collapsed"
                  PaneDisplayMode="LeftCompact" IsPaneOpen="True" OpenPaneLength="260" CompactPaneLength="48"
                  IsSettingsVisible="True" IsPaneToggleButtonVisible="True" AlwaysShowHeader="False"
                  PaneOpening="Navigation_PaneOpening" PaneClosing="Navigation_PaneClosing"
                  ItemInvoked="Navigation_ItemInvoked" SelectionChanged="Navigation_SelectionChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Today" Tag="smart:today"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Upcoming" Tag="smart:upcoming"><NavigationViewItem.Icon><FontIcon Glyph="&#xE787;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="All" Tag="smart:all"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Completed" Tag="smart:completed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Deleted" Tag="smart:deleted"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItemHeader Content="My lists"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="ConflictItem" SelectsOnInvoked="False" Content="Sync conflicts" Tag="conflicts" Visibility="Collapsed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE814;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem SelectsOnInvoked="False" Content="Sync now" Tag="sync"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <InfoBar x:Name="UpdateInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="12,8,12,0">
      <InfoBar.ActionButton><Button x:Name="UpdateButton" Content="Install and restart" Click="Update_Click"/></InfoBar.ActionButton>
     </InfoBar>
     <InfoBar x:Name="AppInfoBar" IsOpen="False" IsClosable="True" Margin="12,8,12,0"/>
    </StackPanel>
    <Grid x:Name="ReminderLayout" Grid.Row="1" SizeChanged="ReminderLayout_SizeChanged">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ReminderColumn"/><ColumnDefinition x:Name="SplitterColumn" Width="8"/><ColumnDefinition x:Name="DetailsColumn"/></Grid.ColumnDefinitions>
     <Grid x:Name="ReminderHost" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="ReminderHeader" Margin="24,20,20,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock x:Name="ViewTitle" Text="Today" TextTrimming="CharacterEllipsis" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="ViewSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button x:Name="ApplePaneButton" Visibility="Collapsed" Style="{StaticResource AppleToolbarButtonStyle}" Click="ApplePane_Click" AutomationProperties.Name="Toggle sidebar" ToolTipService.ToolTip="Toggle sidebar"><FontIcon Glyph="&#xE700;" FontSize="18"/></Button>
        <Button x:Name="AppleSearchButton" Visibility="Collapsed" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSearch_Click" AutomationProperties.Name="Search reminders" ToolTipService.ToolTip="Search reminders (Ctrl+F)"><FontIcon Glyph="&#xE721;" FontSize="18"/></Button>
        <Button x:Name="AppleSortButton" Visibility="Collapsed" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSort_Click" AutomationProperties.Name="Sort reminders" ToolTipService.ToolTip="Sort reminders"><FontIcon Glyph="&#xE8CB;" FontSize="18"/></Button>
        <Button x:Name="AddButton" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Add reminder" ToolTipService.ToolTip="Add reminder (Ctrl+N)" Click="Add_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Name="AddLabel" Text="Add reminder"/></StackPanel></Button>
       </StackPanel>
      </Grid>
      <CheckBox x:Name="AppleShowCompleted" Grid.Row="1" Content="Show completed" Visibility="Collapsed" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="28,0,20,12" Click="AppleShowCompleted_Click"/>
      <Grid x:Name="SearchRow" Grid.Row="1" Padding="24,0,20,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search reminders" QueryIcon="Find" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
       <Button x:Name="SortButton" Grid.Column="1" Width="40" Height="40" AutomationProperties.Name="Sort" ToolTipService.ToolTip="Sort reminders"><Button.Flyout><MenuFlyout><RadioMenuFlyoutItem Text="Manual" Tag="manual" GroupName="sort" IsChecked="True" Click="Sort_Click"/><RadioMenuFlyoutItem Text="Due date" Tag="due" GroupName="sort" Click="Sort_Click"/><RadioMenuFlyoutItem Text="Priority" Tag="priority" GroupName="sort" Click="Sort_Click"/><RadioMenuFlyoutItem Text="Title" Tag="title" GroupName="sort" Click="Sort_Click"/></MenuFlyout></Button.Flyout><FontIcon Glyph="&#xE8CB;" FontSize="18"/></Button>
      </Grid>
      <ListView x:Name="ReminderList" Grid.Row="2" SelectionChanged="ReminderList_SelectionChanged" IsItemClickEnabled="False" Padding="8,0">
       <ListView.GroupStyle><GroupStyle HidesIfEmpty="True">
        <GroupStyle.HeaderContainerStyle><Style TargetType="ListViewHeaderItem"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/></Style></GroupStyle.HeaderContainerStyle>
        <GroupStyle.HeaderTemplate><DataTemplate x:DataType="local:ReminderSection"><TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,10,14,2"/></DataTemplate></GroupStyle.HeaderTemplate>
       </GroupStyle></ListView.GroupStyle>
       <ListView.ItemContainerTransitions><TransitionCollection><AddDeleteThemeTransition/><ReorderThemeTransition/></TransitionCollection></ListView.ItemContainerTransitions>
       <ListView.ItemTemplate><DataTemplate x:DataType="local:ReminderItem"><Grid Padding="10,10"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{x:Bind Completed, Mode=TwoWay}" Click="Complete_Click" VerticalAlignment="Top" AutomationProperties.Name="Mark reminder complete"/>
        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Metadata, Mode=OneWay}" Foreground="{x:Bind MetadataBrush, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Description, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Grid x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><FontIcon Glyph="&#xE90C;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Nothing here" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/><TextBlock Text="Enjoy the quiet—or add a reminder." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
      <Grid x:Name="ReminderFooter" Grid.Row="3" Padding="24,10,20,16"><ToggleSwitch x:Name="ShowCompleted" Header="Show completed" Toggled="ShowCompleted_Toggled"/><TextBlock x:Name="RowCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
     </Grid>
     <primitives:Thumb x:Name="PaneDivider" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
       AutomationProperties.Name="Resize reminder details" IsTabStop="True" UseSystemFocusVisuals="True"
       ToolTipService.ToolTip="Drag to resize or close either pane. Drag from the edge to reopen. Double-click or press Home for automatic sizing. Arrow keys resize."
       DragStarted="PaneDivider_DragStarted" DragDelta="PaneDivider_DragDelta" DragCompleted="PaneDivider_DragCompleted"
       KeyDown="PaneDivider_KeyDown" DoubleTapped="PaneDivider_DoubleTapped">
      <primitives:Thumb.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Size panes automatically" Click="AutomaticPaneSizing_Click"/></MenuFlyout></primitives:Thumb.ContextFlyout>
      <primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Grid Background="Transparent">
       <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
         <VisualState x:Name="Normal"/>
         <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="DividerVisual.Opacity" Value="1"/></VisualState.Setters></VisualState>
         <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DividerVisual.Opacity" Value="1"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
         <VisualState x:Name="Unfocused"/>
         <VisualState x:Name="PointerFocused"/>
         <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="KeyboardFocusLine.Opacity" Value="1"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
       </VisualStateManager.VisualStateGroups>
       <Grid x:Name="DividerVisual" Opacity="0">
        <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Border Width="4" Height="40" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
       </Grid>
       <Border x:Name="KeyboardFocusLine" Width="2" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0"/>
      </Grid></ControlTemplate></primitives:Thumb.Template>
     </primitives:Thumb>
     <Grid x:Name="DetailsHost" Grid.Column="2">
      <StackPanel x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24" MaxWidth="320"><FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Select a reminder" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="Its details will appear here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <ScrollViewer x:Name="DetailPane" Visibility="Collapsed"><StackPanel x:Name="DetailFields" Padding="24,20" MaxWidth="620" HorizontalAlignment="Stretch" Spacing="10">
       <StackPanel.Transitions><TransitionCollection><EntranceThemeTransition FromHorizontalOffset="20"/></TransitionCollection></StackPanel.Transitions>
       <Button x:Name="BackToReminders" Content="Back to reminders" Click="BackToReminders_Click" Visibility="Collapsed"/>
       <TextBlock x:Name="DetailHeading" Text="Details" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,4"/>
       <TextBox x:Name="DetailTitle" Header="Title" TextChanged="Detail_Changed"/>
       <TextBox x:Name="DetailNotes" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" TextChanged="Detail_Changed"/>
       <TextBox x:Name="DetailTags" Header="TAGS" IsReadOnly="True" Visibility="Collapsed"/>
       <Grid x:Name="DetailListPriority" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="DetailList" Header="List" DisplayMemberPath="Title" SelectedValuePath="Id" IsEnabled="False"/><ComboBox x:Name="DetailPriority" Grid.Column="1" Header="Priority" SelectionChanged="Detail_Changed"><ComboBoxItem Content="None" Tag="0"/><ComboBoxItem Content="Low" Tag="9"/><ComboBoxItem Content="Medium" Tag="5"/><ComboBoxItem Content="High" Tag="1"/></ComboBox></Grid>
       <Grid x:Name="DetailDateTime" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CalendarDatePicker x:Name="DetailDate" Header="Due date" DateChanged="Detail_Changed"/><TimePicker x:Name="DetailTime" Grid.Column="1" Header="Time" TimeChanged="Detail_Changed"/></Grid>
       <Button x:Name="AppleClearDue" Content="Clear due date" Visibility="Collapsed" HorizontalAlignment="Left" Foreground="{ThemeResource AppleBlueBrush}" Background="Transparent" BorderThickness="0" Click="AppleClearDue_Click"/>
       <Grid x:Name="DetailToggles" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ToggleSwitch x:Name="DetailAllDay" Header="All day" Toggled="Detail_Changed"/><ToggleSwitch x:Name="DetailFlagged" Grid.Column="1" Header="Flagged" Toggled="Detail_Changed"/></Grid>
       <StackPanel x:Name="DetailActions" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button x:Name="SaveButton" Content="Save changes" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" Click="Save_Click"/><Button x:Name="DeleteButton" Content="Delete" AutomationProperties.Name="Delete reminder" Click="Delete_Click"/></StackPanel>
       <TextBlock x:Name="AppleDetailStatus" Visibility="Collapsed" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </Grid>
  </NavigationView>

  <Grid Grid.ColumnSpan="2" x:Name="AuthGate" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="36" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24"/></TransitionCollection></Border.Transitions>
    <StackPanel Spacing="12">
     <Image Source="Assets/icon-v2.png" Width="64" Height="64" HorizontalAlignment="Center" AutomationProperties.Name="Reminders for Windows icon"/>
     <TextBlock Text="Reminders for Windows" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
     <TextBlock Text="Your iCloud reminders, at home on Windows." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
     <ProgressBar x:Name="GateProgress" IsIndeterminate="True"/>
     <!-- Wrap rather than centre-and-overflow: these messages carry masked
          phone numbers and Apple's own wording, so they routinely exceed the
          card width. Unwrapped, the text is clipped on both sides and widens
          the panel enough to clip the fields below it too. -->
     <TextBlock x:Name="GateStatus" Text="Starting the sync service…" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel x:Name="LoginFields" Spacing="12" Visibility="Collapsed"><TextBox x:Name="AppleIdBox" Header="Apple ID" PlaceholderText="you@icloud.com"/><PasswordBox x:Name="PasswordBox" Header="Password"/><Button Content="Sign in" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SignIn_Click"/></StackPanel>
     <StackPanel x:Name="CodeFields" Spacing="12" Visibility="Collapsed"><TextBox x:Name="CodeBox" Header="Verification code" MaxLength="16"/><Button x:Name="VerifyCode" Content="Verify" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Verify_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4"><HyperlinkButton x:Name="ResendCode" Content="Send a new code" Click="ResendCode_Click"/><HyperlinkButton x:Name="TextCode" Content="Text me a code" Visibility="Collapsed" Click="TextCode_Click"/></StackPanel></StackPanel>
     <InfoBar x:Name="GateError" IsOpen="False" Severity="Error" IsClosable="False"/>
     <HyperlinkButton Content="Privacy policy" HorizontalAlignment="Center" Click="PrivacyPolicy_Click"/>
     <Button Content="Explore the UI with sample data" HorizontalAlignment="Center" Click="Demo_Click"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
